# Public URL of the deployed proxy. This is not a secret.
# Public Supabase browser configuration. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public UI feature flags. Provider credentials remain only in Supabase.
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_APPLE_AUTH=false
VITE_LISTINGS_API_BASE_URL=
VITE_APP_ENV=development
